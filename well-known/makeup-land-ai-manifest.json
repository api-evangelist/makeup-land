  "languages": [
    "he-IL",
    "en"
  ],
  "regions": [
    "IL"
  ],
  "homepage": "https://makeup.land",
  "contact": {
    "email": "info@makeup.land",
    "whatsapp": "+972772233344"
  },
  "ai_usage_policy": {
    "allowed": [
      "search-indexing",
      "answer-engine",
      "agentic-shopping"
    ],
    "conditional": [
      "model-training"
    ],
    "disallowed": [
      "competitive-scraping",
      "price-arbitrage-bots"
    ],
    "attribution_required": true,
    "commercial_use_allowed": true
  },
  "crawler_directives": {
    "respect_robots_txt": true,
    "preferred_rate_limit": "10 rps",
    "preferred_user_agents": [
      "GPTBot",
      "OAI-SearchBot",
      "ClaudeBot",
      "PerplexityBot",
      "Google-Extended",
      "Applebot-Extended"
    ]
  },
  "feeds": [
    {
      "type": "product-catalog",
      "format": "rss-2.0-google-merchant",
      "url": "https://makeup.land/api/merchant/feed"
    },
    {
      "type": "product-catalog",
      "format": "openai-acp-jsonl",
      "url": "https://makeup.land/api/merchant/openai/products"
    },
    {
      "type": "product-reviews",
      "format": "google-product-reviews-v2.4",
