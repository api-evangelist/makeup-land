      "url": "https://makeup.land/llms.txt"
    },
    {
      "type": "api-specification",
      "format": "openapi-3.1",
      "url": "https://makeup.land/openapi.json"
    }
  ],
  "structured_data": {
    "jsonld": [
      "Product",
      "BreadcrumbList",
      "Organization",
      "WebSite"
